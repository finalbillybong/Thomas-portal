rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile: only the authenticated user can read/write their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Portals subcollection
      match /portals/{portalId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Homework subcollection
      match /homework/{homeworkId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Daily status subcollection
      match /dailyStatus/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Audit logs subcollection (nested)
      match /auditLogs/{dateKey}/events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Allow reading audit log date documents
      match /auditLogs/{dateKey} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
