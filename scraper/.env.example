# MCAS login credentials
MCAS_EMAIL=parent@example.com
MCAS_PASSWORD=your-password-here
# Optional — only needed if your MCAS account has multiple children or schools.
# If you only have one child at one school, leave these blank or remove them.
# The scraper logs the available options if it can't find a match.
MCAS_CHILD_NAME=
MCAS_SCHOOL_NAME=

# Firebase — the UID of the user in your Homework Hub app
FIREBASE_UID=your-firebase-user-uid

# Path to your Firebase service account JSON key
# Download from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
